# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# NextAuth Configuration
NEXTAUTH_SECRET=your_random_secret_key_here_min_32_characters
NEXTAUTH_URL=http://localhost:3000

# App Configuration
NODE_ENV=development

# Local BarTender/Sticker Print Service
# Browser calls this directly so deployed Vercel app can print on the local PC.
NEXT_PUBLIC_PRINT_SERVICE_URL=http://localhost:10000

# Optional server-side proxy fallback route. Not used by the certificate page.
BACKEND_API_URL=http://localhost:10000
